
---
interface Props {
  variant?: string;
}
---

<header class="transparent">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="de-flex sm-pt10">

          <!-- Logo and Brand Name -->
          <div class="de-flex-col">
            <div id="logo">
              <a href="/index.html" class="brand-logo-link">
                <img
                  class="logo-main"
                  src="/images/logo1.png"
                  alt="Drashti Surfaces"
                />
                <img
                  class="logo-scroll"
                  src="/images/logo1.png"
                  alt="Drashti Surfaces"
                />
                <img
                  class="logo-mobile"
                  src="/images/logo1.png"
                  alt="Drashti Surfaces"
                />

                <span class="brand-name">
                  Drashti Surfaces
                </span>
              </a>
            </div>
          </div>

          <!-- Navigation -->
          <div class="de-flex-col header-col-mid">
            <ul id="mainmenu">
              <li>
                <a class="menu-item" href="/index.html">Home</a>
              </li>

              <li>
                <a class="menu-item" href="/about.html">About Us</a>
              </li>

              <li>
                <a class="menu-item" href="/services.html">Products</a>
              </li>

              <li>
                <a class="menu-item" href="/projects.html">Projects</a>
              </li>

              <li>
                <a class="menu-item" href="#">Catalogue</a>

                <ul>
                  <li>
                    <a href="/catalouges/EURO Mica Interactive.pdf" download>
                      Euro Mica
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/EURO Veneer Folder 2026 Interactive.pdf" download>
                      Euro Veneer 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/ESS Folder 2026 Interactive PDF.pdf" download>
                      ESS
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/EURO Diet Folder.pdf" download>
                      Euro Diet
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/Nexo Folder 2026.pdf" download>
                      Nexo 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/Pro Plus 2026 Interactive.pdf" download>
                      Pro Plus 2026
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>

                  <li>
                    <a href="/catalouges/Zero by EURO Interactive.pdf" download>
                      Zero By Euro
                      <i class="fa-solid fa-download catalogue-download"></i>
                    </a>
                  </li>
                </ul>
              </li>

              <li>
                <a class="menu-item" href="/contact.html">Contact Us</a>
              </li>
            </ul>
          </div>

          <!-- Right-side controls -->
          <div class="de-flex-col">
            <div class="menu_side_area">

              <!-- Mobile navigation toggle -->
              <span
                id="menu-btn"
                role="button"
                tabindex="0"
                aria-label="Toggle navigation"
                aria-controls="mainmenu"
                aria-expanded="false"
              ></span>
            </div>

            <!-- Desktop hamburger / information panel -->
            <div
              id="btn-extra"
              role="button"
              tabindex="0"
              aria-label="Open information panel"
              aria-controls="extra-wrap"
            >
              <span></span>
              <span></span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Logo and brand name alignment */
  #logo .brand-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Brand name */
  #logo .brand-name {
    display: inline-block;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: 1.2;
    color: #ffffff;
    transition: color 0.3s ease;
  }

  /* Scrolled header brand color */
  header.smaller #logo .brand-name,
  header.header-light #logo .brand-name {
    color: #ffffff;
  }

  /* Catalogue dropdown */
  #mainmenu ul li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .catalogue-download {
    font-size: 13px;
    margin-left: auto;
    padding-left: 25px;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  #mainmenu ul li a:hover .catalogue-download {
    opacity: 1;
    transform: translateY(2px);
  }

  /* Tablet responsiveness */
  @media (max-width: 1199px) {
    #logo .brand-name {
      font-size: 18px;
    }

    #logo .brand-logo-link {
      gap: 9px;
    }
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    #logo .brand-logo-link {
      gap: 8px;
    }

    #logo .brand-name {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
  }

  /* Small mobile screens */
  @media (max-width: 375px) {
    #logo .brand-name {
      font-size: 14px;
    }

    #logo .brand-logo-link {
      gap: 6px;
    }
  }
</style>
