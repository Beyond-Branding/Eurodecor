=========================================== -->

<section class="contact-enquiry">
  <div class="container">

    <div class="row g-5">

      <!-- LEFT CONTENT -->
      <div class="col-lg-4">

        <div class="contact-enquiry-intro wow fadeInUp">

          <h2>Get In Touch</h2>

          <p>
            Need more information?
            <br>
            We will respond to your enquiry.
          </p>

        </div>

      </div>


      <!-- RIGHT FORM -->
      <div class="col-lg-8">

        <div class="wow fadeInUp">

          <!-- FORM SUBMITS TO ADMIN EMAIL -->
          <form
            action="https://formsubmit.co/info@drashtisurfaces.com"
            method="POST"
            id="contact_form"
            name="contactForm">

            <!-- EMAIL CONFIGURATION -->
            <input
              type="hidden"
              name="_subject"
              value="New Website Enquiry - Drashti Surfaces">

            <input
              type="hidden"
              name="_template"
              value="table">

            <input
              type="hidden"
              name="_captcha"
              value="true">

            <!-- Prevent spam -->
            <input
              type="text"
              name="_honey"
              style="display:none">


            <div class="row g-4">

              <!-- ENQUIRY TYPE -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="enquiry_type">
                    <span class="required-star">*</span> Type of Enquiry
                  </label>

                  <select
                    class="form-control"
                    id="enquiry_type"
                    name="Enquiry Type"
                    required>

                    <option value="" selected disabled>
                      Select an enquiry type
                    </option>

                    <option value="Product Enquiry">
                      Product Enquiry
                    </option>

                    <option value="Project Enquiry">
                      Project Enquiry
                    </option>

                    <option value="Dealership">
                      Dealership
                    </option>

                    <option value="Other">
                      Other
                    </option>

                  </select>

                </div>
              </div>


              <!-- FIRST NAME -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="first_name">
                    <span class="required-star">*</span> First Name
                  </label>

                  <input
                    class="form-control"
                    type="text"
                    id="first_name"
                    name="First Name"
                    placeholder="First Name"
                    autocomplete="given-name"
                    required>

                </div>
              </div>


              <!-- LAST NAME -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="last_name">
                    <span class="required-star">*</span> Last Name
                  </label>

                  <input
                    class="form-control"
                    type="text"
                    id="last_name"
                    name="Last Name"
                    placeholder="Last Name"
                    autocomplete="family-name"
                    required>

                </div>
              </div>


              <!-- ORGANIZATION -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="organization">
                    Organization
                  </label>

                  <input
                    class="form-control"
                    type="text"
                    id="organization"
                    name="Organization"
                    placeholder="Organization">

                </div>
              </div>


              <!-- EMAIL -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="email">
                    <span class="required-star">*</span> Email Address
                  </label>

                  <input
                    class="form-control"
                    type="email"
                    id="email"
                    name="Customer Email"
                    placeholder="Email Address"
                    autocomplete="email"
                    required>

                </div>
              </div>


              <!-- PHONE -->
              <div class="col-md-6">
                <div class="field-set">

                  <label for="phone">
                    <span class="required-star">*</span> Phone Number
                  </label>

                  <input
                    class="form-control"
                    type="tel"
                    id="phone"
                    name="Phone Number"
                    placeholder="Phone Number"
                    autocomplete="tel"
                    required>

                </div>
              </div>


              <!-- MESSAGE -->
              <div class="col-12">
                <div class="field-set">

                  <label for="message">
                    <span class="required-star">*</span> Message
                  </label>

                  <textarea
                    class="form-control contact-message"
                    id="message"
                    name="Message"
                    placeholder="Tell us about your requirements"
                    required></textarea>

                </div>
              </div>

              <!-- SUBMIT BUTTON -->
              <div class="col-12">

                <div id="submit">

                  <button
                    class="btn-main"
                    id="send_message"
                    type="submit">

                    Send Message

                  </button>

                </div>

              </div>

            </div>

          </form>

        </div>

      </div>

