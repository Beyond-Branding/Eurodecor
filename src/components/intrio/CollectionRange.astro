
---
const { collection } = Astro.props;
---

<section id="our-collection">
  <div class="container">
  <!-- CATALOGUE DOWNLOADS -->
<div class="catalogue-section">
  <div class="catalogue-header">
    <div class="subtitle">Explore Our Catalogues</div>
    <h3>Discover Our Collections</h3>
  </div>

  <div class="catalogue-grid">

    <div class="catalogue-item">
      <div class="catalogue-name">EURO Veneer</div>
      <a href="/catalouges/EURO Veneer Folder 2026 Interactive.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">EURO Marquetry</div>
      <span class="catalogue-coming">Coming Soon</span>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">ZERO by Euro</div>
      <a href="/catalouges/Zero by EURO Interactive.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">EURO Mica</div>
      <a href="/catalouges/EURO Mica Interactive.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">NEXO by Euro</div>
      <a href="/catalouges/Nexo Folder 2026.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">ESS</div>
      <a href="/catalouges/ESS Folder 2026 Interactive PDF.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">PRO Plus</div>
      <a href="/catalouges/Pro Plus 2026 Interactive.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

    <div class="catalogue-item">
      <div class="catalogue-name">EURO Diet</div>
      <a href="/catalouges/EURO Diet Folder.pdf" download class="catalogue-link">
        <i class="fa-solid fa-download"></i> Download PDF
      </a>
    </div>

  </div>
</div>
    <!-- SECTION HEADING -->
<div class="row g-4 mb-5 collection-heading">

  <div class="col-lg-7">
    <div class="subtitle wow fadeInUp">
      Our Collection
    </div>

    <h2 class="wow fadeInUp" data-wow-delay=".2s">
      {collection.heading}
    </h2>
  </div>

  <div class="col-lg-4">
    <p class="mb-0 wow fadeInUp" data-wow-delay=".4s">
      {collection.intro}
    </p>
  </div>

</div>

 

    <!-- LEFT AND RIGHT ARROWS -->
    <div class="collection-arrows">
      <button type="button" id="collection-prev" aria-label="Scroll left">
        &#8592;
      </button>

      <button type="button" id="collection-next" aria-label="Scroll right">
        &#8594;
      </button>
    </div>

    <!-- ALL 6 PRODUCTS IN ONE ROW -->
    <div class="collection-scroll" id="collection-scroll">
      <div class="collection-track">

        {collection.products.map((product, index) => (
          <div
            class="collection-card wow fadeInUp"
            data-wow-delay={`${(index % 3) * .2}s`}
          >
            <div class="hover relative overflow-hidden text-light">

              <div class="relative overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-100 hover-scale-1-2 collection-product-image"
                  loading="lazy"
                />
              </div>

              <span class="abs top-0 start-0 p-4 z-2">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div class="gradient-edge-bottom h-50"></div>

              <div class="abs bottom-0 p-4 z-2">
                <h3 class="mb-0 text-light">{product.name}</h3>
              </div>

            </div>

            <p class="mt-3 mb-0">{product.description}</p>
          </div>
        ))}

      </div>
    </div>

  </div>
</section>

<style>

/* CATALOGUE SECTION */
.catalogue-section {
  margin: 20px 0 55px;
}

.catalogue-header {
  margin-bottom: 25px;
}

.catalogue-header h3 {
  font-size: 28px;
  margin: 8px 0 0;
}

.catalogue-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.catalogue-item {
  min-height: 115px;
  padding: 22px;
  border: 1px solid #dedbd6;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #fff;
  transition: all 0.3s ease;
}

.catalogue-item:hover {
  border-color: #c9a987;
  transform: translateY(-3px);
}

.catalogue-name {
  font-size: 17px;
  font-weight: 600;
  color: #242323;
}

.catalogue-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #9b7957;
  font-size: 13px;
  text-decoration: none;
  margin-top: 15px;
}

.catalogue-link span {
  font-size: 17px;
}

.catalogue-coming {
  font-size: 13px;
  color: #999;
  margin-top: 15px;
}

@media (max-width: 991px) {
  .catalogue-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 575px) {
  .catalogue-grid {
    grid-template-columns: 1fr;
  }

  .catalogue-header h3 {
    font-size: 23px;
  }
}

  /* ARROWS */
  .collection-arrows {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-bottom: 24px;
  }

  .collection-arrows button {
    width: 46px;
    height: 46px;
    border: 1px solid #c9a987;
    border-radius: 50%;
    background: transparent;
    color: #242323;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .collection-arrows button:hover {
    background: #242323;
    color: #fff;
    border-color: #242323;
  }

  /* SCROLL CONTAINER */
  .collection-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .collection-scroll::-webkit-scrollbar {
    display: none;
  }

  /* FORCE EVERY PRODUCT INTO ONE ROW */
  .collection-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 24px;
    width: max-content;
  }

  /* 3 CARDS VISIBLE ON DESKTOP */
  .collection-card {
    flex: 0 0 calc((min(100vw - 48px, 1320px) - 48px) / 3);
    width: calc((min(100vw - 48px, 1320px) - 48px) / 3);
    min-width: 0;
    scroll-snap-align: start;
  }

  .collection-product-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* TABLET */
  @media (max-width: 991px) {
    .collection-card {
      flex-basis: 42vw;
      width: 42vw;
    }
  }

  /* MOBILE */
  @media (max-width: 575px) {
    .collection-track {
      gap: 16px;
    }

    .collection-card {
      flex-basis: 82vw;
      width: 82vw;
    }

    .collection-arrows button {
      width: 40px;
      height: 40px;
    }
  }

  .collection-heading {
  display: flex;
  align-items: flex-start !important;
}

.collection-heading .col-lg-7,
.collection-heading .col-lg-4 {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.collection-heading .col-lg-4 {
  padding-top: 35px;
}

.collection-heading h2 {
  margin-bottom: 0;
}

.collection-heading p {
  line-height: 1.8;
  margin: 0;
}

@media (max-width: 991px) {
  .collection-heading .col-lg-4 {
    padding-top: 0;
  }
}
</style>

<script>
  const scrollContainer = document.querySelector<HTMLElement>(
    "#collection-scroll"
  );

  const previousButton = document.querySelector<HTMLButtonElement>(
    "#collection-prev"
  );

  const nextButton = document.querySelector<HTMLButtonElement>(
    "#collection-next"
  );

  function scrollProducts(direction: number) {
    if (!scrollContainer) return;

    const card = scrollContainer.querySelector<HTMLElement>(
      ".collection-card"
    );

    if (!card) return;

    const track = scrollContainer.querySelector<HTMLElement>(
      ".collection-track"
    );

    const gap = track
      ? parseFloat(getComputedStyle(track).columnGap) || 24
      : 24;

    scrollContainer.scrollBy({
      left: direction * (card.getBoundingClientRect().width + gap),
      behavior: "smooth"
    });
  }

  previousButton?.addEventListener("click", () => {
    scrollProducts(-1);
  });

  nextButton?.addEventListener("click", () => {
    scrollProducts(1);
  });


</script>
